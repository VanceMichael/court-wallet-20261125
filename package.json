{
  "name": "court-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:partner": "node support/peer.mjs",
    "build": "node --check support/peer.mjs && node --check src/*.mjs && node --check tests/*.test.mjs tests/helpers/*.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:race": "node --test tests/race.test.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "test:unknown": "node --test tests/unknown-payment.test.mjs",
    "test:authz": "node --test tests/authz.test.mjs",
    "test:window": "node --test tests/effective-window.test.mjs"
  }
}
